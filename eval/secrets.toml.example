# Copy this to eval/secrets.toml and fill in the keys you have.
# eval/secrets.toml is gitignored — never commit real keys.
#
# These are injected into os.environ at startup (same variable names rag.py
# already reads via os.environ.get(...)), so anything you set here works for
# both the generator backend and the RAGAS judge backend.
#
# You only need the keys for the backend(s) you actually use — see
# eval/config.toml [llm].backend and [judge].backend.

GEMINI_API_KEY = ""
GROQ_API_KEY = ""
MISTRAL_API_KEY = ""
OPENROUTER_API_KEY = ""
COHERE_API_KEY = ""
ANTHROPIC_API_KEY = ""
OPENAI_API_KEY = ""
